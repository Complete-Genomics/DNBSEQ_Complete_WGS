//includeConfig 'queue.config'
report.overwrite = true
trace.overwrite = true
timeline.overwrite = true

params {
	stLFRreseq_mbp = false 	// stLFRreseq v1.4 (built by Junhua Rao)
	FQC = false
	stLFR_only = params.FQC ? true : false
	PF_only = false
	frombam = false 	// cwgs from bam file
	fromMergedBam = false
	params.frombam = params.fromMergedBam ? true : false
	se_mode = false
	debug = false
	keepFiles = false

	cut_len = 46700000 // myref phase

	alignOnly = false // without cv
	

	
	//fq
	lariatStLFRBC = true
	lariatSplitFqNum = 50 //split fq for tofake10x and tolariat process; 1: dont split
	MOD = "$baseDir"
	DB = "${MOD}/../database"
	SCRIPT = "${MOD}/../scripts/"
	SCRIPT_HapCUT2 = "/usr/local/app/HapCUT2-1.3.1/HapCUT2-master/utilities/"

	BIN = ""
	BIN_HAPCUT2 = ""
	BIN_fqcheck = ""

	
	MEGABOLT_RUNIT = "runit -O15" 
	//MEGABOLT_RUNIT_SEC = 15
	MEGABOLT = "/mnt/ssd/MegaBOLT_scheduler/bin/MegaBOLT_client"
	MEGABOLT_PATH = "/mnt/ssd/MegaBOLT"
	MEGABOLT_EXPORT = """
    export LD_LIBRARY_PATH=${MEGABOLT_PATH}/lib:\$LD_LIBRARY_PATH
    export PATH=${MEGABOLT_PATH}/bin:\$PATH
	export MBP_TASK_WORKSPACE=${launchDir}
	"""

	outdir = "$PWD/output/" //should be absolute path

	//barcode pos info
	//BARCODE_POS = "-I 201 10 1 false -I 217 10 1 false -I 233 10 1 false"
					//PE so pos add 100bp
	
	//reference
	ref = "hg38"	//hs37d5, hg38 or hg19
	ref_len = 	2934876545
	std = "hg002"	//support hg001 and hg002
	
	//sample fastq
	sampleFq = false
	stLFR_fq_cov = 40
	PF_fq_cov = 50

	//use megabolt?
	use_megabolt = false

	//align
	align_tool = params.stLFRreseq_mbp ? "bwa" : "lariat" // bwa lariat_bwa
	pfAligner = "bwa" // or vg
	pfmapq = 3 // no filter bam
	PF_lt_stLFR_depth = 10	//extract stlfr bam (regions larger than bamcov in stlfr bam and pfbam cov smaller than this)
	run_bqsr = true

	markdup = "biobambam2" //or sambamba (not recommend) or picard or gatk4

	//downsample bam
	sampleBam = false
	stLFR_sampling_cov = 30
	PF_sampling_cov = 40

	just_combine = false
	//call variants //var_tool = gatk dv gatk_dv
	//gatk options
	var_tool = "dv"
	gatk_version = "v4" // or v3
	run_vqsr = true
	split_by_intervals = true //haplotypecaller -L option

	dv_version = "v1.10"
	dv_machine = "t7" //or g400

	dv_container = "/storeData/cg_teams/cg_research/ycai/completeWGS/pipeline/sif/deepvariant-1.10.0.sif"
	dv_binary_path = "run_pangenome_aware_deepvariant"
	dv_pangenome = "/storeData/cg_teams/cg_research/ycai/completeWGS/pipeline/v1.0.6/CWGS_db/hg38/panGenome/hprc-v2.1-mc-grch38.gbz"
	dv_gbz_shm_size_gb = 50
	dv_make_examples_extra_args = ''
	dv_postprocess_variants_extra_args = ''
	// haploid_contigs: set to "chrX chrY" for male, "" for female
	dv_haploid_contigs = "chrX chrY"
	dv_par_regions_bed = "${DB}/${ref}/panGenome/GRCh38_PAR.bed"
	
	// phasing
	chr = "all"
	/////////////////////queue config
	queue = "mgi.q"
	project = "W21P0024"
	boltq = 'fpga4.q'
	//extraCluOpt = "\n set +o posix"
	extraCluOpt = "-S /bin/bash"
	clusterOptions = ""

	CPU0 = 1
	CPU1 = 8

	MEM0 = 1
	MEM1 = 4
	MEM2 = 24
	MEM3 = 60

	// for user 
	cpu2 = 24
	cpu3 = 24


// if (params.debug) {
// 		cpu1 = 1
// 		mem1 = 1

// 		cpu2 = 8
// 		mem2 = 8

// 		cpu3 = 8
// 		mem3 = 8
// 	}
}


executor {
	name   = 'local'
	cpus   = 128
	memory = '480 GB'
}

process {
	executor = 'local'
	maxForks = 100
	exitReadTimeout = '300 min'
	env.PATH = "$baseDir/../bin:${env.PATH}"
	errorStrategy = 'ignore'
	caching = 'lenient'
	//errorStrategy = 'retry'
	//maxRetries = 1
}
