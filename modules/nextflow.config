//includeConfig 'queue.config'
report.overwrite = true
trace.overwrite = true
timeline.overwrite = true

params {
	stLFRreseq_mbp = false 	// stLFRreseq v1.4 (built by Junhua Rao)
	FQC = false
	stLFR_only = false
	PF_only = false
	frombam = false 	// cwgs from bam file
	fromMergedBam = false
	se_mode = false
	debug = false
	keepFiles = false

	cut_len = 46700000 // myref phase

	// per-haplotype de novo assembly (60kb overlapping windows)
	run_haplodenovo      = false
	denovo_window_size   = 60000
	denovo_window_step   = 30000
	denovo_chunk_lines   = 200    // windows per nextflow task
	denovo_min_reads     = 50
	denovo_max_reads     = 20000  // subsample cap per window
	denovo_min_contig    = 500

	// SE600 barcode split: UMI = bc1(10)+spacer(6)+bc2(10)+spacer(6)+bc3(10) = 42bp
	// umi_start (1-based) — UMI position in the read; varies by sequencer setup
	//   UMI at read start: umi_start = 1   (gDNA = seq[42:])
	//   UMI at read end:   umi_start = read_len - 41
	se600_umi_start      = 1
	// For SE600, input already has #bc1_bc2_bc3/[12] in its FASTQ header and its
	// sequence contains gDNA only; bypass barcode_split_se600.
	skipBarcodeSplit     = false
	skip_specimmune       = false
	// GangSTR requires a paired-end insert-size distribution and is disabled for SE600.
	skip_gangstr          = true
	// SpecImmune runs from the shared Conda environment, not a SIF.
	specimmune_env        = "/storeData/cg_teams/cg_research/ycai/tools/miniconda3/envs/SpecImmune"
	specimmune_home       = "/home/bpeters/bin/SpecImmune"
	specimmune_db         = "/storeData/cg_teams/cg_research/ycai/completeWGS/pipeline/v1.0.6/CWGS_db/SpecImmune/db"
	specimmune_read_type  = "pacbio"
	specimmune_align_method = "minimap2"

	alignOnly = false // without cv
	

	
	//fq
	lariatStLFRBC = true
	lariatSplitFqNum = 50 //split fq for tofake10x and tolariat process; 1: dont split
	MOD = "$baseDir"
	DB = "${baseDir}/../database"
	SCRIPT = "${baseDir}/../scripts/"
	SCRIPT_HapCUT2 = "/usr/local/app/HapCUT2-1.3.1/HapCUT2-master/utilities/"

	BIN = ""
	BIN_HAPCUT2 = ""
	BIN_fqcheck = ""

	
	MEGABOLT_RUNIT = "runit -O15" 
	//MEGABOLT_RUNIT_SEC = 15
	MEGABOLT = "/mnt/ssd/MegaBOLT_scheduler/bin/MegaBOLT_client"
	MEGABOLT_PATH = "/mnt/ssd/MegaBOLT"
	MEGABOLT_EXPORT = """
	    export LD_LIBRARY_PATH=/mnt/ssd/MegaBOLT/lib:\$LD_LIBRARY_PATH
	    export PATH=/mnt/ssd/MegaBOLT/bin:\$PATH
	export MBP_TASK_WORKSPACE=${launchDir}
	"""

	outdir = "${env('PWD')}/output/" //should be absolute path

	//barcode pos info
	//BARCODE_POS = "-I 201 10 1 false -I 217 10 1 false -I 233 10 1 false"
					//PE so pos add 100bp
	
	//reference
	ref = "hg38"	//hs37d5, hg38 or hg19
	ref_len = 	2934876545
	std = "hg002"	//support hg001 and hg002
	// left unset on purpose: align.nf falls back to "${params.DB}/${params.ref}/panGenome/..."
	// at task runtime, so these correctly follow the -db override instead of being frozen
	// to a baseDir-relative path when this config is parsed
	pangenome_prefix = null
	vg_pangenome_gbz = null
	vg_pangenome_hapl = null
	
	//sample fastq
	sampleFq = false
	stLFR_fq_cov = 40
	PF_fq_cov = 50

	//use megabolt?
	use_megabolt = false

	//align
	align_tool = params.stLFRreseq_mbp ? "bwa" : "lariat" // bwa lariat_bwa
	pfAligner = "vg" // or bwa
	pfmapq = 3 // no filter bam
	PF_lt_stLFR_depth = 10	//extract stlfr bam (regions larger than bamcov in stlfr bam and pfbam cov smaller than this)
	run_bqsr = true

	markdup = "picard" //or biobambam2, sambamba (not recommend), or gatk4

	//downsample bam
	sampleBam = false
	stLFR_sampling_cov = 30
	PF_sampling_cov = 40

	demo = false
	just_combine = false
	//call variants //var_tool = gatk dv gatk_dv
	//gatk options
	var_tool = "dv"
	gatk_version = "v4" // or v3
	run_vqsr = true
	split_by_intervals = true //haplotypecaller -L option

	dv_version = "v1.10-se600-xyflags"
	dv_machine = "t7" //or g400

	dv_container = "/storeData/cg_teams/cg_research/ycai/completeWGS/pipeline/sif/deepvariant-1.10.0-xyflags.sif"
	dv_binary_path = "run_pangenome_aware_deepvariant"
	// left unset on purpose: callvariants.nf falls back to "${params.DB}/${params.ref}/panGenome/..."
	// at task runtime, so it correctly follows the -db override
	dv_pangenome = null
	dv_gbz_shm_size_gb = 50  // --gbz_shared_memory_size_gb, new in v1.10
	dv_customized_model = "/storeData/cg_teams/cg_research/ycai/completeWGS/pipeline/DV_Models/checkpoint-177536-0.98710-1"  // SE600 fine-tuned checkpoint; set "" to fall back to the stock WGS model
	dv_make_examples_extra_args = ''
	dv_postprocess_variants_extra_args = ''
	// Per-sample sex handling for DeepVariant: auto, male, or female.
	// In auto mode, a chrY mean depth below this threshold is classified as female.
	dv_sex_mode = "auto"
	dv_sex_chrY_contig = "chrY"
	dv_female_max_chrY_mean_depth = 0.1
	// Used only for samples classified or forced as male.
	dv_haploid_contigs = "chrX chrY"
	dv_par_regions_bed = ""  // derived from dv_pangenome directory if empty
	
	// phasing
	chr = "all"
	/////////////////////queue config
	queue = "mgi.q"
	project = "W21P0024"
	boltq = 'fpga4.q'
	//extraCluOpt = "\n set +o posix"
	extraCluOpt = "-S /bin/bash"
	clusterOptions = ""

	CPU0 = 1
	CPU1 = 8

	MEM0 = 1
	MEM1 = 4
	MEM2 = 24
	MEM3 = 60

	// Empirical high-memory process limits from the German WGS trace.
	// Override these for a different reference, read type, or host capacity.
	vg_memory          = '160 GB'
	deepvariant_memory = '160 GB'
	markdup_memory     = '16 GB'
	pangenie_memory    = '80 GB'
	stlfrqc_memory     = '96 GB'
	vcfeval_memory     = '64 GB'
	specimmune_memory  = '64 GB'

	// VEP is currently pure --cache/--offline (no --plugin), so 20 GB is a
	// conservative estimate for --fork-based cache annotation. If dbNSFP/
	// CADD/AlphaMissense plugins are ever wired in via --plugin, bump this to
	// 32-64 GB: each fork loads its own copy of the plugin data files, so
	// memory no longer scales the same way as cache-only mode.
	vep_memory = '20 GB'

	// Machine-wide mutex directory so at most one `vg giraffe` runs at a time
	// on this host, even across separate nextflow runs. `maxForks 1` on the
	// vg process alone is NOT enough: WF_align_pf and WF_align_stlfr2 each
	// call vg() independently, so DSL2 tracks them as two separate process
	// nodes (CWGS:WF_align_pf:vg and CWGS:WF_align_stlfr2:vg), each with its
	// own maxForks=1 counter -- letting 2 vg giraffe run concurrently.
	vg_lock_dir = "/storeData/cg_teams/cg_research/ycai/completeWGS/pipeline/.locks/vg_giraffe.lock"

	// for user 
	cpu2 = 24
	cpu3 = 24
	local_max_forks = 24


// if (params.debug) {
// 		cpu1 = 1
// 		mem1 = 1

// 		cpu2 = 8
// 		mem2 = 8

// 		cpu3 = 8
// 		mem3 = 8
// 	}
}


process {
	executor = 'local'
	maxForks = params.local_max_forks
	exitReadTimeout = '300 min'
	env.PATH = "$baseDir/../bin:${env('PATH')}"
	errorStrategy = 'terminate'
	caching = true
	//errorStrategy = 'retry'
	//maxRetries = 1
}

profiles {
	singularity {
		singularity.enabled    = true
		singularity.autoMounts = true
		docker.enabled         = false
		// pulled image cached here; override with --singularity.cacheDir /your/path
		singularity.cacheDir   = "${projectDir}/../sif_cache"
	}
	mac_stub {
		process {
			executor    = 'local'
			maxForks    = 8
			cpus        = 2
			memory      = '4 GB'
			errorStrategy = 'terminate'   // fail fast so stub errors are visible
		}
		params {
			chr               = 'chr22'
			CPU0              = 1
			CPU1              = 2
			cpu2              = 2
			cpu3              = 2
			MEM0              = 1
			MEM1              = 2
			MEM2              = 4
			MEM3              = 4
			clusterOptions    = ''
			queue             = 'local'
			use_megabolt      = false
			run_haplodenovo   = false      // haplodenovo is off by default in stub
		}
		singularity.enabled = false
		docker.enabled      = false
	}
}
