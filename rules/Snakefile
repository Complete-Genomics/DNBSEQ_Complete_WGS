#!/usr/bin/env python3
"""
DNBSEQ Complete WGS Snakemake Pipeline
Converted from Nextflow pipeline
"""

import os
import pandas as pd
from pathlib import Path

# Configuration
configfile: "config.yaml"

# Load sample information
def load_samples():
    samples = {}
    with open(config["input"]) as f:
        header = f.readline().strip().split('\t')
        for line in f:
            if line.strip():
                parts = line.strip().split('\t')
                sample = parts[0]
                lane = parts[1] if len(parts) > 1 else "L1"
                fqs = parts[2].split(',') if len(parts) > 2 else []
                read_len = config.get("read_len", 150)  # Use read_len from config
                
                if sample not in samples:
                    samples[sample] = {}
                samples[sample][lane] = {
                    'fqs': fqs,
                    'read_len': read_len
                }
    return samples

SAMPLES = load_samples()
SAMPLE_IDS = list(SAMPLES.keys())

# Define aligners and variant callers
ALIGNERS = config.get("aligners", ["bwa"])
VARCALLERS = config.get("varcallers", ["dv"])

# Main rule
rule all:
    input:
        # Final outputs
        expand(config["outdir"] + "/{sample}/report/{sample}_report.html", sample=SAMPLE_IDS),
        config["outdir"] + "/report.csv",
        config["outdir"] + "/report_fqc.csv",
        # Optional analysis outputs (if enabled in config)
        expand(config["outdir"] + "/{sample}/hla/hlala_out", sample=SAMPLE_IDS) if config.get("enable_hla", False) else [],
        expand(config["outdir"] + "/{sample}/gangstr/GangSTR_out.vcf", sample=SAMPLE_IDS) if config.get("enable_gangstr", False) else [],
        expand(config["outdir"] + "/{sample}/cnv/{sample}.CNV.result.xls", sample=SAMPLE_IDS) if config.get("enable_cnv", False) else []

# Include rule modules
include: "rules/fq.smk"
include: "rules/qc.smk"
include: "rules/align.smk"
include: "rules/bam_filter.smk"
include: "rules/callvariants.smk"
include: "rules/phase.smk"
include: "rules/annot.smk"
include: "rules/cnvsv.smk"
include: "rules/fragment.smk"
include: "rules/genedepth.smk"
include: "rules/vcfeval.smk"
include: "rules/hla.smk"
include: "rules/pangenie.smk"
include: "rules/gangstr.smk"
include: "rules/report.smk"

# Sample parsing and QC
rule parse_sample:
    input:
        samplelist = config["input"]
    output:
        csv = config["outdir"] + "/samples.csv"
    shell:
        """
        python {config[script_dir]}/tosamplelist.py {input.samplelist} > {output.csv}
        """
