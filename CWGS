        # ENV += envPaths if executor == 'slurm' else ''

        ## nf executor setting
        project = args.project
        project_para = f"-P {project} -q" if project != 'none' else " -q "
        queue = args.queue
        boltq = args.boltq
        partition = args.partition
        nodelist = "--nodelist " + args.nodelist if args.nodelist else "" 
        
        clusterOptions = f'-clear -cwd -l vf=MEMORY,num_proc=CPUS  -binding linear:CPUS {project_para} QUEUE' if executor == 'sge' else f'--mem=MEMORY --ntasks=CPUS --cpus-per-task=1 --partition={partition} {nodelist}'
        
        ## make config 
        nextflow_config =f"""
        params{{
            clusterOptions = \'{clusterOptions}\'
            MEGABOLT_RUNIT = "chmod a+rx .; {MEGABOLT_RUNIT_CMD}" 
            MOD = "{modules}"
            SCRIPT = "{script}"
            DB = "{database}"
            queue = "{queue}"
            boltq = "{boltq}"
        }}
        process{{
