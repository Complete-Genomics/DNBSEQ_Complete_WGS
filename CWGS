            print(f"{SGE_dir} does NOT exist! Please specify another one with '-sge' or use '-exec local' to run locally.")
            sys.exit(1)
        SGE_ENV = f"--env 'PATH={_SGE_BIN}:$PATH' --env SGE_ROOT=$SGE_ROOT --env SGE_QMASTER_PORT=$SGE_QMASTER_PORT --env SGE_EXECD_PORT=$SGE_EXECD_PORT"

