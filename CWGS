    run_parser.add_argument('samplelist',   help="""Sample info txt file, one line for one lane, each line with 4 columns split by tab:\nsample_name: Sample name\nlane: Lane name\nfastqs: Reads file path; if PE, separate by comma\nread len (single read len x2 if PE)""")

    run_parser.add_argument('-run',          default=N + '_run',         help=f'nextflow running dir [{N}_run]')
    run_parser.add_argument('-out', '-o',    default='result',           help='Output directory [result]')

    run_parser.add_argument('-ansi',         action='store_true',        help='nextflow use ansi-log')
    run_parser.add_argument('-debug',        action='store_true',        help='debug mode')

    run_parser.add_argument('-db',           default=database_default,   help='database path')
    run_parser.add_argument('-script',       default=script_default,     help='script path')
    run_parser.add_argument('-module',       default=modules_default,    help='The directory of the nextflow modules')

    run_parser.add_argument('-partition',    default='debug',            help='set sbatch job partition [debug]')
    run_parser.add_argument('-nodelist',     default=None,            help='sbatch --nodelist [None]')
    run_parser.add_argument('-queue',        default='mgi.q',            help='set qsub job queue [mgi.q]')
    run_parser.add_argument('-boltq',        default='fpga4.q',          help='set qsub job fpga analysis queue [fpga4.q]')
    run_parser.add_argument('-project',      default='W21P0024',         help='set qsub job project, or set \'none\' [W21P0024]')


