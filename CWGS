        RUNIT_CMD += ' -A'
        MEGABOLT_RUNIT_OPT += ' -A'

    MEGABOLT_RUNIT_CMD = f"{MEGABOLT_RUNIT} -s {MEGABOLT_RUNIT_OPT}" if MEGABOLT_RUNIT else ''

