        binds = ','.join(binds)
        
        param = ""
        if args.dl_only:
            param = "--dl_only"
        elif args.make_only:
            param = "--make_only"

        cmd = f"""
        singularity  exec --no-home -C -e --pwd `pwd -P` -B {binds} {container} \\
            createdb CWGS_db --url_list /usr/local/app/CWGS/urls.txt --db /usr/local/app/CWGS/CWGS_db.tar.xz {param}
        """
        print(cmd)
        os.system(cmd)

    if args.subparser_name == 'run':
        samplelist  = os.path.realpath(args.samplelist)
        output      = os.path.realpath(args.out)
        database    = os.path.realpath(args.db)
        modules     = os.path.realpath(args.module) if args.module != modules_default else args.module
        script      = os.path.realpath(args.script) if args.script != script_default else args.script

        ## find paths to bind
        if not os.path.isdir(output):
            os.mkdir(output)

        container_dir   = '' if container == container_default else os.path.dirname(container)
        runit_dir       = '' if runit == runit_default else os.path.dirname(runit)
        script_dir      = '' if script == script_default else os.path.dirname(script)
        modules_dir     = '' if modules == modules_default else os.path.dirname(modules)

        path_list = get_path(samplelist)
        path_list += ['/mnt', database, container_dir, runit_dir, script_dir, output, os.getcwd()]
        if args.B:
            for a in args.B.split(','):
                path_list.append(a)
        path_list = merge_paths(path_list)
        bind_str = ','.join(path_list)
        bind_str += ",/etc/slurm,/etc/passwd,/usr/lib/x86_64-linux-gnu/slurm-wlm,/run/munge" if executor == "slurm" else ""

        script_bind_para    = f'-B {script}:{app_dir}/scripts' if script_dir else ''
