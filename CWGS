        L_PATH = MEGA_PATH
        cpulimit = f"/usr/local/miniconda3/envs/six/bin/cpulimit -l {args.cpulimit}00 -z" if args.cpulimit else ''
    else:
        _SGE_BIN = f"{SGE_dir}/bin/{SGE_ARCH}" 
